{
  "name": "@ehf/case-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./outbox-relay": "./src/outbox-relay.ts",
    "./ledger-export": "./src/ledger-export.ts",
    "./ledger-segment": "./src/ledger-segment.ts",
    "./governance": "./src/governance.ts",
    "./discovery": "./src/discovery.ts",
    "./discovery-observer": "./src/discovery-observer.ts",
    "./recon-jobs": "./src/recon-jobs.ts",
    "./recon-web-search": "./src/recon-web-search.ts",
    "./recon-worker": "./src/recon-worker.ts"
