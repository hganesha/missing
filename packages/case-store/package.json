  "dependencies": {
    "@ehf/blob-store": "workspace:*",
    "@ehf/context-plane": "workspace:*",
    "@ehf/contracts": "workspace:*",
    "@ehf/fincrime-integration": "workspace:*",
    "@ehf/identity": "workspace:*",
