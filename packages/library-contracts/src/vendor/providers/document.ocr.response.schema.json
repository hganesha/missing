{
  "$defs": {
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "OcrPage": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "$ref": "#/$defs/PositiveCount"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "page",
        "text"
      ],
      "type": "object"
    },
    "OcrParser": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "PositiveCount": {
      "minimum": 1,
      "type": "integer"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:provider:document.ocr:response:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pages": {
      "items": {
        "$ref": "#/$defs/OcrPage"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "parser": {
      "$ref": "#/$defs/OcrParser"
    }
  },
  "required": [
    "pages",
    "parser"
  ],
  "type": "object"
}
