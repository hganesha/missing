{
  "$defs": {
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "ExtractionObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/Text"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/ExtractionSpan"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        }
      },
      "required": [
        "path",
        "status",
        "confidence",
        "spans",
        "note"
      ],
      "type": "object"
    },
    "ExtractionResponse": {
      "additionalProperties": false,
      "properties": {
        "contract_hash": {
          "$ref": "#/$defs/Hash"
        },
        "document_type": {
          "$ref": "#/$defs/Id"
        },
        "document_version": {
          "$ref": "#/$defs/Id"
        },
        "extracted_fields": {
          "$ref": "#/$defs/JsonObject"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ExtractionObservation"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "profile_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_digest": {
          "$ref": "#/$defs/Hash"
        }
      },
      "required": [
        "document_type",
        "profile_version",
        "contract_hash",
        "document_version",
        "source_digest",
        "extracted_fields",
        "observations"
      ],
      "type": "object"
    },
    "ExtractionSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/PositiveCount"
        },
        "page_id": {
          "$ref": "#/$defs/Id"
        },
        "quote": {
          "$ref": "#/$defs/Text"
        },
        "start": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "page_id",
        "start",
        "end",
        "quote"
      ],
      "type": "object"
    },
    "Hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object",
      "x-dynamic-map-reason": "schema-selected or source-domain JSON values"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "ObservationStatus": {
      "enum": [
        "present",
        "not_present",
        "illegible",
        "redacted",
        "ambiguous",
        "not_applicable"
      ]
    },
    "PositiveCount": {
      "minimum": 1,
      "type": "integer"
    },
    "Probability": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:provider:document.fields:response:2.0.0",
  "$ref": "#/$defs/ExtractionResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
